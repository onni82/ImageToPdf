<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UserSecretsId>75e42612-4451-4960-a8d0-db1f97d97b62</UserSecretsId>
	<AssemblyTitle>Image to PDF</AssemblyTitle>
	<AssemblyDescription>Merge images and PDF pages into a PDF</AssemblyDescription>
	<AssemblyCompany>Onni Bucht</AssemblyCompany>
	<AssemblyProduct>Image to PDF</AssemblyProduct>
	<AssemblyCopyright>© 2026 Onni Bucht</AssemblyCopyright>
	<AssemblyVersion>1.0.0.0</AssemblyVersion>
	<FileVersion>1.0.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pdfium.Net.SDK" Version="5.1.3" />
  </ItemGroup>

</Project>
