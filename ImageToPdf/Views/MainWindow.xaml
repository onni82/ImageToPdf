<Window x:Class="ImageToPdf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageToPdf.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddImagesButton" Width="120" Margin="0,0,8,0">Add Images...</Button>
            <Button x:Name="OpenPdfButton" Width="120" Margin="0,0,8,0">Open PDF...</Button>
            <Button x:Name="ExportButton" Width="120">Export PDF...</Button>
        </StackPanel>

        <ListBox x:Name="ItemsListBox" Grid.Row="1" DisplayMemberPath="DisplayName" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button x:Name="RemoveButton" Width="120" Margin="0,0,8,0">Remove Selected</Button>
        </StackPanel>
    </Grid>
</Window>
