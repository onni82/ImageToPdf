<Window x:Class="ImageToPdf.Views.TiffOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIFF Options" Height="180" Width="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock Text="Choose TIFF compression:" FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel>
            <RadioButton Name="rbNone" Content="None" IsChecked="True" Margin="0,4" />
            <RadioButton Name="rbLzw" Content="LZW (lossless)" Margin="0,4" />
            <RadioButton Name="rbCcitt3" Content="CCITT Group 3 (bilevel)" Margin="0,4" />
            <RadioButton Name="rbCcitt4" Content="CCITT Group 4 (bilevel)" Margin="0,4" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="btnOk" Width="80" Margin="0,0,8,0" IsDefault="True">OK</Button>
            <Button Name="btnCancel" Width="80" IsCancel="True">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
